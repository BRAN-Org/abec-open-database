{
  "name": "abec-open-database",
  "version": "1.0.0",
  "description": "Base de dados pública e REST API do acervo completo do ABEC Meeting (2013-2025), mantida pela BRAN Org.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "data:scrape": "python3 scripts/scrape_abec.py",
    "data:convert": "node scripts/convert_csv_to_json.js",
    "data:validate": "node scripts/validate_dataset.js"
  },
  "keywords": [
    "abec-meeting",
    "open-data",
    "bran-org",
    "api",
    "academic-data",
    "express"
  ],
  "author": "BRAN Org",
  "license": "CC-BY-4.0",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0"
  }
}
