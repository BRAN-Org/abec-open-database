{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "Faculdade / Periódico / Evento Científico",
    "githubUrl": "https://github.com/BRAN-Org/bran-web-database-template",
    "doiUrl": "https://doi.org/10.5281/zenodo.0000000",
    "issuesUrl": "https://github.com/BRAN-Org/bran-web-database-template/issues"
  },
  "dataset": {
    "title": "BRAN Academic Database Template",
    "description": "Infraestrutura aberta de dados acadêmicos e científicos. Este portal disponibiliza acervos públicos de anais, edições e periódicos em formatos limpos e padronizados, com API REST pública e ferramentas para análise cientométrica e bibliométrica no Brasil.",
    "version": "1.0.0",
    "doi": "10.5281/zenodo.0000000",
    "license": "A ser definida (Configurável)",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "doi",
    "secondaryKey": "id"
  },
  "schema": {
    "searchFields": ["title", "abstract", "authors", "keywords", "tools", "data_sources"],
    "facets": [
      { "key": "year", "label": "Ano / Edição", "type": "number", "multi": true },
      { "key": "author", "label": "Autor", "type": "string", "targetField": "authors" },
      { "key": "tool", "label": "Ferramenta / Software", "type": "string", "targetField": "tools" },
      { "key": "source", "label": "Fonte de Dados", "type": "string", "targetField": "data_sources" },
      { "key": "stage", "label": "Etapa Metodológica", "type": "string", "targetField": "usage_stages" }
    ],
    "sortFields": [
      { "key": "title", "label": "Título" },
      { "key": "year", "label": "Ano" },
      { "key": "doi", "label": "DOI" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topTools", "label": "Principais Ferramentas / Softwares", "sourceField": "tools", "limit": 10 },
      { "key": "topSources", "label": "Principais Fontes de Dados", "sourceField": "data_sources", "limit": 10 },
      { "key": "topAuthors", "label": "Principais Autores", "sourceField": "authors", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição por Ano", "sourceField": "year" },
      { "key": "stageBreakdown", "label": "Etapas Metodológicas", "sourceField": "usage_stages" }
    ]
  }
}
