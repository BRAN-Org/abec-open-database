{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "ABEC Brasil - Associação Brasileira de Editores Científicos",
    "githubUrl": "https://github.com/BRAN-Org/abec-open-database",
    "doiUrl": "https://doi.org/10.21452/abecmeeting",
    "issuesUrl": "https://github.com/BRAN-Org/abec-open-database/issues"
  },
  "dataset": {
    "title": "ABEC Meeting Open Database",
    "description": "Base de dados aberta e acervo completo 100% digitalizado dos anais e resumos das edições do ABEC Meeting (2013-2025), promovidos pela Associação Brasileira de Editores Científicos (ABEC Brasil) e disponibilizados pela BRAN Org sob princípios FAIR e BOAI.",
    "version": "1.0.0",
    "doi": "10.21452/abecmeeting",
    "license": "CC-BY 4.0",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "doi",
    "secondaryKey": "id"
  },
  "schema": {
    "searchFields": ["title", "abstract", "authors", "keywords", "section", "issue", "affiliations"],
    "facets": [
      { "key": "year", "label": "Ano de Publicação", "type": "number", "multi": true },
      { "key": "author", "label": "Autor", "type": "string", "targetField": "authors" },
      { "key": "section", "label": "Eixo Temático / Seção", "type": "string", "targetField": "section" },
      { "key": "keyword", "label": "Palavra-chave", "type": "string", "targetField": "keywords" },
      { "key": "issue", "label": "Edição do Evento", "type": "string", "targetField": "issue" }
    ],
    "sortFields": [
      { "key": "year", "label": "Ano" },
      { "key": "title", "label": "Título" },
      { "key": "doi", "label": "DOI" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topAuthors", "label": "Principais Autores", "sourceField": "authors", "limit": 10 },
      { "key": "topKeywords", "label": "Palavras-chave Mais Utilizadas", "sourceField": "keywords", "limit": 10 },
      { "key": "topSections", "label": "Principais Seções / Eixos Temáticos", "sourceField": "section", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição de Trabalhos por Ano", "sourceField": "year" },
      { "key": "sectionBreakdown", "label": "Distribuição por Seção", "sourceField": "section" }
    ]
  }
}
